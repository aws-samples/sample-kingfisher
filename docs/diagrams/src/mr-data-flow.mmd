flowchart LR
  subgraph SRC["Data sources (attached to an execution region)"]
    J["JDBC<br/>MySQL · PostgreSQL<br/>Oracle · SQL Server"]
    N["DynamoDB"]
    O["S3 / Athena external tables"]
    ST["Streams: Kinesis · MSK"]
  end
  subgraph ING["Integration (runs in that region)"]
    GL["Glue sync job<br/>full / incremental<br/>date variables<br/>overwrite / merge"]
    DMS["DMS CDC"]
    ZE["zero-ETL"]
    FL["Flink SQL (MSAF)"]
  end
  subgraph STORE["Storage (that region)"]
    S3T[("S3 Tables table bucket<br/>bgp-table-bucket · Iceberg")]
    RS[("Redshift Serverless")]
  end
  subgraph META["Metadata"]
    GDC["Glue Data Catalog<br/>federated catalog s3tablescatalog"]
    OM["OpenMetadata<br/>(home region, one instance)<br/>scheduled ingestion<br/>+ event push<br/>column-level lineage"]
    MIR[("bgp-metadata-mirror<br/>cross-region<br/>read-only mirror")]
  end
  subgraph USE["Consumption"]
    ATH["Athena direct query"]
    RSQ["Redshift query"]
    GB["Ask-Your-Data · reports<br/>requests workbench"]
    GOV["Governance: catalog<br/>classification and masking<br/>quality · lineage · modeling"]
  end
  J & N & O --> GL --> S3T & RS
  J --> DMS --> RS
  J --> ZE --> RS
  ST --> FL --> S3T
  S3T --> GDC --> ATH
  RS --> RSQ
  S3T & RS --> OM --> MIR
  ATH & RSQ --> GB
  OM & RS & S3T --> GOV
