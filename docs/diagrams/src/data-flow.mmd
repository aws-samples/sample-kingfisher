flowchart LR
  subgraph SRC["数据源(四范式 / 8 源)"]
    JDBC[("JDBC ×4<br/>MySQL/PG/Oracle/MSSQL")]
    OBJ[("对象存储<br/>S3")]
    NOSQL[("NoSQL<br/>DynamoDB")]
    STREAM[("流<br/>Kinesis / MSK")]
  end
  subgraph ING["数据集成"]
    BATCH["Glue ETL(批)<br/>全量 overwrite / 增量 append(水位列)"]
    CDC["实时 CDC<br/>DMS / Zero-ETL / Flink"]
  end
  subgraph LAKE["Lakehouse"]
    S3T[("S3 Tables<br/>Iceberg")]
    RS[("Redshift<br/>Serverless")]
    DL[("S3 Data Lake")]
  end
  subgraph ENG["多引擎计算(SPI)"]
    E["Glue · EMR Serverless<br/>Athena · Redshift SQL · Flink"]
  end
  subgraph GOV["治理"]
    OM["OpenMetadata<br/>目录 + 列级血缘"]
  end
  subgraph AI["生成式 AI 平面"]
    BR["Bedrock Claude Opus<br/>GenBI / Copilot / 顾问"]
  end
  JDBC & OBJ & NOSQL & STREAM -->|批抽取| BATCH
  JDBC -->|变更流| CDC
  STREAM -->|实时| CDC
  BATCH -->|write Iceberg| S3T
  BATCH -->|Data API load| RS
  BATCH --> DL
  CDC -->|apply| S3T
  CDC -->|apply| RS
  S3T & RS & DL --> E
  E -->|只读 SQL / 结果| BR
  JDBC & OBJ & NOSQL & STREAM -. 表/列元数据 .-> OM
  S3T & RS -. 表/列元数据 .-> OM
  BATCH & CDC & E -. 列级 + 计算血缘 .-> OM
