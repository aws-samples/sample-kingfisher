flowchart LR
  subgraph SRC["Data sources (4 paradigms / 8 sources)"]
    JDBC[("JDBC ×4<br/>MySQL/PG/Oracle/MSSQL")]
    OBJ[("Object storage<br/>S3")]
    NOSQL[("NoSQL<br/>DynamoDB")]
    STREAM[("Streams<br/>Kinesis / MSK")]
  end
  subgraph ING["Data integration"]
    BATCH["Glue ETL (batch)<br/>full overwrite /<br/>incremental append<br/>(watermark column)"]
    CDC["Real-time CDC<br/>DMS / Zero-ETL / Flink"]
  end
  subgraph LAKE["Lakehouse"]
    S3T[("S3 Tables<br/>Iceberg")]
    RS[("Redshift<br/>Serverless")]
    DL[("S3 Data Lake")]
  end
  subgraph ENG["Multi-engine compute (SPI)"]
    E["Glue · EMR Serverless<br/>Athena · Redshift SQL · Flink"]
  end
  subgraph GOV["Governance"]
    OM["OpenMetadata<br/>catalog + column-level lineage"]
  end
  subgraph AI["Generative AI plane"]
    BR["Bedrock Claude Opus<br/>GenBI / Copilot / advisors"]
  end
  JDBC & OBJ & NOSQL & STREAM -->|batch extract| BATCH
  JDBC -->|change stream| CDC
  STREAM -->|real-time| CDC
  BATCH -->|write Iceberg| S3T
  BATCH -->|Data API load| RS
  BATCH --> DL
  CDC -->|apply| S3T
  CDC -->|apply| RS
  S3T & RS & DL --> E
  E -->|read-only SQL / results| BR
  JDBC & OBJ & NOSQL & STREAM -. table / column metadata .-> OM
  S3T & RS -. table / column metadata .-> OM
  BATCH & CDC & E -. column-level + compute lineage .-> OM
