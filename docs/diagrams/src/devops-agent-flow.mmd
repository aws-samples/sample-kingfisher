flowchart LR
  subgraph S1["① Page (browser)"]
    CLICK["User clicks AI Diagnosis<br/>inputs taskId, runId"]
  end
  subgraph S2["② Platform back end (Next.js on ECS)"]
    API["POST /api/diagnostics<br/>auth, write running record<br/>return diagnosticId at once"]
  end
  subgraph S3["③ Evidence collection (back end, async)"]
    EVID["Assemble the evidence<br/>run status / script / real logs"]
    CW[("CloudWatch · Glue<br/>· Redshift logs")]
  end
  subgraph S4["④ AWS DevOps Agent (managed SRE · aidevops)"]
    CHAT["CreateChat → session<br/>SendMessage → evidence"]
    ANALYZE["Autonomously correlates<br/>logs / metrics, finds root<br/>cause → streams the report"]
  end
  subgraph S5["⑤ Merge and write back"]
    MERGE["Merge Agent replies<br/>into a report"]
    STORE[("Diagnosis record<br/>bgp-diagnostics")]
  end
  subgraph S6["⑥ Back to the page"]
    POLL["Page polls every 3s<br/>GET /api/diagnostics/id"]
    SHOW["Modal shows the<br/>diagnosis report"]
  end

  CLICK -->|"POST taskId, runId"| API
  API -->|"background<br/>fire-and-forget"| EVID
  CW -. real logs .-> EVID
  EVID -->|"call DevOps Agent"| CHAT
  CHAT --> ANALYZE
  ANALYZE -->|"streamed report"| MERGE
  MERGE --> STORE
  API -. returns diagnosticId immediately .-> POLL
  STORE -. read by the polling .-> POLL
  POLL --> SHOW
