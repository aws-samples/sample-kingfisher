{
  // @netadvisor/core 独立编译成 CJS 的配置。
  // 与 tsconfig.core.json(@genbi/core)、tsconfig.paramadvisor-core.json 同构,只换 rootDir/include
  // 指向 network-advisor/core。
  // 【不 extends 主 tsconfig】:主 tsconfig 是 es5 + noEmit + module esnext + @/ paths,
  // 不适合产出给容器 import 的 CJS。此处独立声明,保证 core 脱离 platform alias 也能编译
  // (network-advisor/core 只 import type 本目录 ./types,零 @/ 依赖,比 param-advisor/core 更干净)。
  "compilerOptions": {
    "module": "commonjs",
    "target": "ES2020",
    "moduleResolution": "node",
    "lib": ["ES2020"],
    "declaration": true,
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "outDir": "./.tmp-core-build",
    "rootDir": "./src/lib/network-advisor/core"
  },
  "include": ["src/lib/network-advisor/core/**/*.ts"]
}
