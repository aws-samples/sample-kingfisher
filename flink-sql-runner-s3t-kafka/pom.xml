<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>com.bgp</groupId>
  <artifactId>flink-sql-runner-s3t-kafka</artifactId>
  <version>1.0</version>
  <packaging>jar</packaging>

  <!-- 模块 32 / P42.6b 路径2 — Kafka/MSK 源 → S3 Tables(托管 Iceberg)sink 【组合包】runner。
       为什么要这个独立包(Bug#5 根治):
         · s3t 包(flink-sql-runner-s3t)未打 Flink SQL kafka connector(SPI 无 KafkaDynamicTableFactory);
         · assembleModularUberJar 命中 iceberg-s3tables 即短路返回 s3t 包(§2.0 分治:iceberg 重栈 8.9万条目
           走预构建、不走运行期 adm-zip 合并,后者撞 ZIP64 65535 上限)——于是 kafka 模块被吞;
         · 结果 kafka 源 × iceberg sink 组合启动即崩 "Could not find any factory for identifier 'kafka'"。
       方案 D(用户拍板):= s3t 包 + flink-sql-connector-kafka + aws-msk-iam-auth + relocation,一次性 maven
       预构建成组合包(maven-shade 处理 ZIP64,统一 Jackson,无运行期合并)。现有 s3t 包【一字不改】→
       Kinesis/CDC→S3Tables 零辐射零回归;装配路由(flink-connectors.ts)按"kafka源+iceberg sink"选本包。
       真跑坐实(2026-08-02):MSAF RUNNING + Athena 查得窗口聚合精确对上 MSK topic 源数据。
       与 flink-sql-runner-s3t 除 kafka/msk 两依赖 + relocation 外【逐字一致】(src 同源复制),将来 s3t
       runner 改动本包同改。 -->
  <properties>
    <maven.compiler.release>11</maven.compiler.release>
    <flink.version>1.20.0</flink.version>
    <kinesis.connector.version>5.0.0-1.20</kinesis.connector.version>
    <!-- Flink CDC(MySQL binlog 源):Apache Flink CDC 3.2.1,支持 Flink 1.20。模块32 — 多 source。 -->
    <flinkcdc.version>3.2.1</flinkcdc.version>
    <!-- MySQL JDBC 驱动:mysql-cdc 的 Debezium 运行时需 com.mysql.cj.jdbc.Driver(connector fat jar 未内嵌)。 -->
    <mysql.driver.version>8.4.0</mysql.driver.version>
    <iceberg.version>1.9.1</iceberg.version>
    <avro.version>1.12.0</avro.version>
    <hadoop.version>3.4.0</hadoop.version>
    <!-- Kafka 源:flink-sql-connector-kafka 3.4.0-1.20(Flink 1.20 版);MSK IAM 认证:aws-msk-iam-auth 2.2.0
         (2.2.0 是 Java8 字节码 ≤ MSAF Java11;2.3.x 是 Java17 起,MSAF 跑不了——真跑教训 [[msk-flink-three-hard-constraints]])。 -->
    <kafka.connector.version>3.4.0-1.20</kafka.connector.version>
    <msk.iam.auth.version>2.2.0</msk.iam.auth.version>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
  </properties>

  <!-- 统一 AWS SDK v2 版本(2.38.2):s3-tables-catalog:0.1.8 传递 aws-sdk 2.29.26,而 s3tables:2.38.2
       需要新版 aws-core 才有的 AuthSchemePreferenceResolver;不锁版本会按声明顺序选到旧版 → NoClassDefFoundError。
       用官方 BOM 强制全部 aws-sdk v2 模块对齐 2.38.2(与 AWS 官方 S3TableSink 示例一致)。 -->
  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>software.amazon.awssdk</groupId>
        <artifactId>bom</artifactId>
        <version>2.38.2</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <!-- Flink core/table:MSAF 运行时提供(not bundled) -->
    <dependency><groupId>org.apache.flink</groupId><artifactId>flink-streaming-java</artifactId><version>${flink.version}</version><scope>provided</scope></dependency>
    <dependency><groupId>org.apache.flink</groupId><artifactId>flink-clients</artifactId><version>${flink.version}</version><scope>provided</scope></dependency>
    <dependency><groupId>org.apache.flink</groupId><artifactId>flink-table-api-java-bridge</artifactId><version>${flink.version}</version><scope>provided</scope></dependency>
    <dependency><groupId>org.apache.flink</groupId><artifactId>flink-table-planner-loader</artifactId><version>${flink.version}</version><scope>provided</scope></dependency>
    <dependency><groupId>org.apache.flink</groupId><artifactId>flink-table-runtime</artifactId><version>${flink.version}</version><scope>provided</scope></dependency>

    <!-- MSAF runtime properties helper(small, bundled) -->
    <dependency><groupId>com.amazonaws</groupId><artifactId>aws-kinesisanalytics-runtime</artifactId><version>1.2.0</version><scope>provided</scope></dependency>

    <!-- Source connector(Kinesis,最新 5.0.0-1.20)+ JSON format(bundled) -->
    <dependency><groupId>org.apache.flink</groupId><artifactId>flink-sql-connector-aws-kinesis-streams</artifactId><version>${kinesis.connector.version}</version></dependency>
    <dependency><groupId>org.apache.flink</groupId><artifactId>flink-json</artifactId><version>${flink.version}</version></dependency>

    <!-- Source connector(MySQL CDC,Apache Flink CDC 3.2.1):直接消费 MySQL binlog。模块32 — 多 source。 -->
    <dependency><groupId>org.apache.flink</groupId><artifactId>flink-sql-connector-mysql-cdc</artifactId><version>${flinkcdc.version}</version></dependency>
    <!-- MySQL JDBC 驱动(bundled):flink-sql-connector-mysql-cdc 的 Debezium 运行时按 com.mysql.cj.jdbc.Driver
         加载,但该 fat connector 未内嵌驱动 → 运行时 NoClassDefFoundError: com/mysql/cj/jdbc/Driver。显式打入。 -->
    <dependency><groupId>com.mysql</groupId><artifactId>mysql-connector-j</artifactId><version>${mysql.driver.version}</version></dependency>

    <!-- 🔴 Kafka/MSK 源(本包相对 s3t 包的唯一增量):flink-sql-connector-kafka(SQL kafka connector,
         补上 s3t 包缺失的 KafkaDynamicTableFactory)+ aws-msk-iam-auth(MSK IAM 认证 IAMClientCallbackHandler)。
         下方 relocation 把 org.apache.kafka → org.apache.flink.kafka.shaded.org.apache.kafka,使 msk-iam-auth
         的 IAMClientCallbackHandler 匹配 flink-sql-connector-kafka 内 shaded 的 AuthenticateCallbackHandler。 -->
    <dependency><groupId>org.apache.flink</groupId><artifactId>flink-sql-connector-kafka</artifactId><version>${kafka.connector.version}</version></dependency>
    <dependency><groupId>software.amazon.msk</groupId><artifactId>aws-msk-iam-auth</artifactId><version>${msk.iam.auth.version}</version></dependency>

    <!-- Flink Iceberg 用 DropWizard metrics(bundled) -->
    <dependency><groupId>org.apache.flink</groupId><artifactId>flink-metrics-dropwizard</artifactId><version>${flink.version}</version></dependency>

    <!-- Iceberg(bundled),Flink 1.20 集成 -->
    <dependency><groupId>org.apache.iceberg</groupId><artifactId>iceberg-core</artifactId><version>${iceberg.version}</version>
      <exclusions><exclusion><groupId>org.apache.avro</groupId><artifactId>avro</artifactId></exclusion></exclusions></dependency>
    <dependency><groupId>org.apache.iceberg</groupId><artifactId>iceberg-aws</artifactId><version>${iceberg.version}</version>
      <exclusions><exclusion><groupId>org.apache.avro</groupId><artifactId>avro</artifactId></exclusion></exclusions></dependency>
    <dependency><groupId>org.apache.iceberg</groupId><artifactId>iceberg-flink-1.20</artifactId><version>${iceberg.version}</version>
      <exclusions><exclusion><groupId>org.apache.avro</groupId><artifactId>avro</artifactId></exclusion></exclusions></dependency>
    <dependency><groupId>org.apache.iceberg</groupId><artifactId>iceberg-api</artifactId><version>${iceberg.version}</version>
      <exclusions><exclusion><groupId>org.apache.avro</groupId><artifactId>avro</artifactId></exclusion></exclusions></dependency>

    <!-- Avro(Iceberg manifest 需要,bundled) -->
    <dependency><groupId>org.apache.avro</groupId><artifactId>avro</artifactId><version>${avro.version}</version></dependency>

    <!-- S3 Tables catalog + SDK(bundled) -->
    <dependency><groupId>software.amazon.s3tables</groupId><artifactId>s3-tables-catalog-for-iceberg</artifactId><version>0.1.8</version>
      <exclusions><exclusion><groupId>ch.qos.logback</groupId><artifactId>logback-classic</artifactId></exclusion></exclusions></dependency>
    <dependency><groupId>software.amazon.awssdk</groupId><artifactId>s3tables</artifactId><version>2.38.2</version>
      <exclusions><exclusion><groupId>ch.qos.logback</groupId><artifactId>logback-classic</artifactId></exclusion></exclusions></dependency>

    <!-- Hadoop(Iceberg Configuration / IO 需要,bundled) -->
    <dependency><groupId>org.apache.hadoop</groupId><artifactId>hadoop-common</artifactId><version>3.4.0</version><!-- 与 <hadoop.version> 同值;写字面量是让依赖扫描器解析到版本(2026-11-02 GitLab grype 把属性引用当成版本未知) -->
      <exclusions>
        <exclusion><groupId>org.apache.avro</groupId><artifactId>avro</artifactId></exclusion>
        <exclusion><groupId>org.slf4j</groupId><artifactId>slf4j-reload4j</artifactId></exclusion>
        <exclusion><groupId>org.slf4j</groupId><artifactId>slf4j-log4j12</artifactId></exclusion>
        <exclusion><groupId>ch.qos.logback</groupId><artifactId>logback-classic</artifactId></exclusion>
        <exclusion><groupId>ch.qos.logback</groupId><artifactId>logback-core</artifactId></exclusion>
      </exclusions>
    </dependency>
  </dependencies>

  <build>
    <finalName>flink-sql-runner-s3t-kafka</finalName>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.11.0</version>
        <configuration><release>11</release></configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
        <version>3.5.1</version>
        <executions>
          <execution>
            <phase>package</phase>
            <goals><goal>shade</goal></goals>
            <configuration>
              <createDependencyReducedPom>false</createDependencyReducedPom>
              <artifactSet>
                <excludes>
                  <exclude>org.apache.flink:force-shading</exclude>
                  <exclude>com.google.code.findbugs:jsr305</exclude>
                  <exclude>org.slf4j:*</exclude>
                  <exclude>org.apache.logging.log4j:*</exclude>
                </excludes>
              </artifactSet>
              <transformers>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                  <mainClass>com.bgp.flink.FlinkSqlRunner</mainClass>
                </transformer>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
              </transformers>
              <!-- 🔴 relocation:aws-msk-iam-auth 的 IAMClientCallbackHandler implements org.apache.kafka...
                   AuthenticateCallbackHandler;而 flink-sql-connector-kafka 内部已把 kafka client shade 到
                   org.apache.flink.kafka.shaded.org.apache.kafka。不 relocate → 两个 AuthenticateCallbackHandler
                   接口不同一 → connector 加载 callback handler 时 ClassCastException。把 msk-iam-auth 侧的
                   org.apache.kafka 也 relocate 到同一 shaded 命名空间,两者对齐(真跑坐实 IAM 认证连 broker 成功)。
                   注:mysql-cdc 内部的 kafka 是 org.apache.flink.cdc.connectors.shaded.org.apache.kafka(不同前缀),
                   本 relocation 不误伤(subagent 双复核 + 真跑坐实 CDC→S3Tables parity 不破)。 -->
              <relocations>
                <relocation>
                  <pattern>org.apache.kafka</pattern>
                  <shadedPattern>org.apache.flink.kafka.shaded.org.apache.kafka</shadedPattern>
                </relocation>
              </relocations>
              <filters>
                <filter><artifact>*:*</artifact><excludes>
                  <exclude>META-INF/*.SF</exclude><exclude>META-INF/*.DSA</exclude><exclude>META-INF/*.RSA</exclude>
                  <exclude>META-INF/versions/**</exclude>
                </excludes></filter>
              </filters>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
